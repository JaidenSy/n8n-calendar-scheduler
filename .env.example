# n8n Configuration
# Copy this to .env and fill in your values

# Timezone (find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
GENERIC_TIMEZONE=America/Los_Angeles

# Port (default 5678)
N8N_PORT=5678

# Encryption key for credentials (generate a random string)
# Run: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
N8N_ENCRYPTION_KEY=

# Webhook URL (set this when using ngrok/tunnel)
# WEBHOOK_URL=https://your-ngrok-url.ngrok.io

# Optional: Store n8n data in this project folder
# N8N_USER_FOLDER=./.n8n
