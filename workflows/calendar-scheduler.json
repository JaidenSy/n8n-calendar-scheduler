[
  {
    "name": "Claude Calendar Scheduler",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "claude-calendar",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "a1b2c3d4-1111-2222-3333-444455556666",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [250, 300],
        "webhookId": "claude-calendar"
      },
      {
        "parameters": {
          "rules": {
            "rules": [
              {
                "outputKey": "get_availability",
                "conditions": {
                  "options": { "version": 2 },
                  "combinator": "and",
                  "conditions": [
                    {
                      "leftValue": "={{ $json.body.action }}",
                      "rightValue": "get_availability",
                      "operator": { "type": "string", "operation": "equals" }
                    }
                  ]
                }
              },
              {
                "outputKey": "create_session",
                "conditions": {
                  "options": { "version": 2 },
                  "combinator": "and",
                  "conditions": [
                    {
                      "leftValue": "={{ $json.body.action }}",
                      "rightValue": "create_session",
                      "operator": { "type": "string", "operation": "equals" }
                    }
                  ]
                }
              },
              {
                "outputKey": "get_schedule",
                "conditions": {
                  "options": { "version": 2 },
                  "combinator": "and",
                  "conditions": [
                    {
                      "leftValue": "={{ $json.body.action }}",
                      "rightValue": "get_schedule",
                      "operator": { "type": "string", "operation": "equals" }
                    }
                  ]
                }
              },
              {
                "outputKey": "update_progress",
                "conditions": {
                  "options": { "version": 2 },
                  "combinator": "and",
                  "conditions": [
                    {
                      "leftValue": "={{ $json.body.action }}",
                      "rightValue": "update_progress",
                      "operator": { "type": "string", "operation": "equals" }
                    }
                  ]
                }
              }
            ]
          },
          "options": {}
        },
        "id": "a1b2c3d4-2222-3333-4444-555566667777",
        "name": "Route by Action",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3,
        "position": [450, 300]
      },
      {
        "parameters": {
          "operation": "getAll",
          "calendar": {
            "__rl": true,
            "mode": "list",
            "value": "primary"
          },
          "returnAll": true,
          "options": {
            "timeMax": "={{ $now.plus({ days: 7 }).toISO() }}",
            "timeMin": "={{ $now.toISO() }}"
          }
        },
        "id": "a1b2c3d4-3333-4444-5555-666677778888",
        "name": "Get Calendar Events",
        "type": "n8n-nodes-base.googleCalendar",
        "typeVersion": 1.2,
        "position": [700, 100]
      },
      {
        "parameters": {
          "jsCode": "// Get all busy slots from calendar events\nconst events = $input.all();\n\nconst busySlots = events.map(e => ({\n  summary: e.json.summary || 'Busy',\n  start: e.json.start?.dateTime || e.json.start?.date,\n  end: e.json.end?.dateTime || e.json.end?.date\n}));\n\n// Define preferred learning times\nconst preferredHours = {\n  weekday: { start: 18, end: 21 },\n  weekend: { start: 9, end: 17 }\n};\n\nreturn [{\n  json: {\n    success: true,\n    busy_slots: busySlots,\n    preferred_hours: preferredHours,\n    timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,\n    message: `Found ${busySlots.length} existing events in the next 7 days`\n  }\n}];"
        },
        "id": "a1b2c3d4-4444-5555-6666-777788889999",
        "name": "Process Availability",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [900, 100]
      },
      {
        "parameters": {
          "operation": "create",
          "calendar": {
            "__rl": true,
            "mode": "list",
            "value": "primary"
          },
          "start": "={{ $json.body.data.start_time }}",
          "end": "={{ DateTime.fromISO($json.body.data.start_time).plus({ minutes: $json.body.data.duration_minutes || 60 }).toISO() }}",
          "additionalFields": {
            "summary": "={{ $json.body.data.title }}",
            "description": "={{ $json.body.data.description }}\n\nPhase: {{ $json.body.data.phase }}\nTopics: {{ $json.body.data.topics ? $json.body.data.topics.join(', ') : 'N/A' }}\n\n---\nScheduled via Claude Code"
          }
        },
        "id": "a1b2c3d4-5555-6666-7777-888899990000",
        "name": "Create Calendar Event",
        "type": "n8n-nodes-base.googleCalendar",
        "typeVersion": 1.2,
        "position": [700, 250]
      },
      {
        "parameters": {
          "jsCode": "const event = $input.first().json;\n\nreturn [{\n  json: {\n    success: true,\n    event_id: event.id,\n    title: event.summary,\n    start: event.start?.dateTime,\n    end: event.end?.dateTime,\n    link: event.htmlLink,\n    message: 'Learning session scheduled successfully'\n  }\n}];"
        },
        "id": "a1b2c3d4-6666-7777-8888-999900001111",
        "name": "Format Create Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [900, 250]
      },
      {
        "parameters": {
          "operation": "getAll",
          "calendar": {
            "__rl": true,
            "mode": "list",
            "value": "primary"
          },
          "returnAll": true,
          "options": {
            "query": "n8n Learning",
            "timeMax": "={{ $now.plus({ days: 14 }).toISO() }}",
            "timeMin": "={{ $now.toISO() }}"
          }
        },
        "id": "a1b2c3d4-7777-8888-9999-000011112222",
        "name": "Get Learning Sessions",
        "type": "n8n-nodes-base.googleCalendar",
        "typeVersion": 1.2,
        "position": [700, 400]
      },
      {
        "parameters": {
          "jsCode": "const events = $input.all();\n\nconst sessions = events\n  .filter(e => e.json.summary?.toLowerCase().includes('n8n'))\n  .map(e => ({\n    id: e.json.id,\n    title: e.json.summary,\n    start: e.json.start?.dateTime || e.json.start?.date,\n    end: e.json.end?.dateTime || e.json.end?.date,\n    description: e.json.description,\n    link: e.json.htmlLink\n  }))\n  .sort((a, b) => new Date(a.start) - new Date(b.start));\n\nreturn [{\n  json: {\n    success: true,\n    upcoming_sessions: sessions,\n    count: sessions.length,\n    message: sessions.length > 0 \n      ? `Found ${sessions.length} upcoming n8n learning sessions`\n      : 'No upcoming n8n learning sessions found'\n  }\n}];"
        },
        "id": "a1b2c3d4-8888-9999-0000-111122223333",
        "name": "Format Schedule Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [900, 400]
      },
      {
        "parameters": {
          "operation": "update",
          "calendar": {
            "__rl": true,
            "mode": "list",
            "value": "primary"
          },
          "eventId": "={{ $json.body.data.event_id }}",
          "updateFields": {
            "description": "={{ $json.body.data.notes ? 'COMPLETED\\n\\nNotes: ' + $json.body.data.notes : 'COMPLETED' }}"
          }
        },
        "id": "a1b2c3d4-9999-0000-1111-222233334444",
        "name": "Update Event Progress",
        "type": "n8n-nodes-base.googleCalendar",
        "typeVersion": 1.2,
        "position": [700, 550]
      },
      {
        "parameters": {
          "jsCode": "const event = $input.first().json;\n\nreturn [{\n  json: {\n    success: true,\n    event_id: event.id,\n    title: event.summary,\n    message: 'Progress updated - session marked as completed'\n  }\n}];"
        },
        "id": "a1b2c3d4-0000-1111-2222-333344445555",
        "name": "Format Update Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [900, 550]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ $json }}",
          "options": {}
        },
